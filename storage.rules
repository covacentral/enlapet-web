rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /pets/{imageId} {
      // Permitir la subida y eliminación solo si el usuario es dueño de la foto (el nombre del archivo comienza con su UID)
      allow write: if request.auth != null && imageId.startsWith(request.auth.uid + "_");
      
      // La lectura es pública para que cualquiera que escanee el collar NFC pueda ver la foto de la mascota
      allow read: if true;
    }
  }
}
