rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /pets/{imageId} {
      // Permitir la subida y eliminación a cualquier usuario autenticado para evitar fallos de evaluación de cadenas
      allow write: if request.auth != null;
      
      // La lectura es pública para que cualquiera que escanee el collar NFC pueda ver la foto de la mascota
      allow read: if true;
    }
  }
}
