rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Funciones de ayuda
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. Colección de Usuarios (Dueños)
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // 2. Colección de Mascotas (Pets)
    match /pets/{petId} {
      // El dueño puede leer, actualizar o borrar sus mascotas
      allow read, update, delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      
      // Permitir la creación de mascotas si se asocian correctamente al creador
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      
      // Acceso público de lectura: solo a través del token seguro (no por listado general)
      allow get: if true; 

      // Subcolección de historial clínico
      match /medical_records/{recordId} {
        allow read, update, delete: if isAuthenticated() && get(/databases/$(database)/documents/pets/$(petId)).data.ownerId == request.auth.uid;
        allow create: if isAuthenticated() && get(/databases/$(database)/documents/pets/$(petId)).data.ownerId == request.auth.uid;
        allow get: if true;
      }
    }

    // 3. Mapeo de NFC (secureToken -> petId)
    match /nfc_mappings/{secureToken} {
      // Lectura pública permitida para resolver la URL del collar NFC
      allow read: if true;
      
      // Creación del mapeo: solo si el dueño de la mascota coincide con el autenticado
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      
      // Solo el dueño puede borrar o actualizar su mapeo
      allow update, delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }
  }
}
