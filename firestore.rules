rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Funciones de ayuda
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        ('email' in request.auth.token) && 
        (request.auth.token.email == 'covacentral@gmail.com' || request.auth.token.email.matches('.*admin.*'));
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. Colección de Usuarios (Dueños)
    match /users/{userId} {
      allow read, write: if isAdmin() || isOwner(userId);
    }

    // 2. Colección de Mascotas (Pets)
    match /pets/{petId} {
      // El dueño o el administrador maestro pueden leer (get/list), actualizar o borrar
      allow read, update, delete: if isAdmin() || (isAuthenticated() && resource.data.ownerId == request.auth.uid);
      
      // Permitir la creación de mascotas si se asocian correctamente al creador
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      
      // Acceso público de lectura: solo a través del token seguro (no por listado general)
      allow get: if true; 

      // Subcolección de historial clínico
      match /medical_records/{recordId} {
        allow read, write: if isAdmin() || (isAuthenticated() && get(/databases/$(database)/documents/pets/$(petId)).data.ownerId == request.auth.uid);
        allow get: if true;
      }
    }

    // 3. Mapeo de NFC (secureToken -> petId)
    match /nfc_mappings/{secureToken} {
      // Lectura pública permitida para resolver la URL del collar NFC
      allow read: if true;
      
      // Creación del mapeo: solo si el dueño de la mascota coincide con el autenticado
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      
      // Solo el dueño o el admin pueden borrar o actualizar su mapeo
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.ownerId == request.auth.uid);
    }

    // 4. Colección de Clínicas (Clinics)
    match /clinics/{clinicId} {
      // Cualquiera puede leer la carta de presentación y datos públicos de la clínica
      allow read: if true;
      
      // Solo el administrador de la clínica o el admin maestro pueden escribir
      allow write: if isAdmin() || (isAuthenticated() && request.auth.uid == clinicId);

      // Subcolección de Inventario
      match /inventory/{itemId} {
        allow read, write: if isAuthenticated() && (request.auth.uid == clinicId || exists(/databases/$(database)/documents/clinics/$(clinicId)/staff/$(request.auth.uid)));
      }

      // Subcolección de Facturas
      match /invoices/{invoiceId} {
        allow read, write: if isAuthenticated() && (request.auth.uid == clinicId || exists(/databases/$(database)/documents/clinics/$(clinicId)/staff/$(request.auth.uid)));
      }

      // Subcolección de Citas
      match /appointments/{appointmentId} {
        allow create: if isAuthenticated();
        allow read, update, delete: if isAuthenticated() && (request.auth.uid == clinicId || resource.data.ownerId == request.auth.uid || request.resource.data.ownerId == request.auth.uid);
      }

      // Subcolección de Logs de Auditoría
      match /audit_logs/{logId} {
        allow create: if isAuthenticated() && (request.auth.uid == clinicId || exists(/databases/$(database)/documents/clinics/$(clinicId)/staff/$(request.auth.uid)));
        allow read: if isAuthenticated() && request.auth.uid == clinicId;
      }

      // Subcolección de Staff
      match /staff/{staffId} {
        allow read: if isAuthenticated();
        allow write: if isAdmin() || (isAuthenticated() && (request.auth.uid == clinicId || request.auth.uid == staffId));
      }
    }

    // 5. Colección de Permisos Clínicos
    match /clinical_permissions/{permissionId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.vetId || request.auth.uid == resource.data.ownerId);
      allow create: if isAuthenticated() && request.resource.data.vetId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (request.auth.uid == resource.data.ownerId || request.auth.uid == resource.data.vetId);
    }

    // 6. Colección de Verificaciones de Veterinarios (Staff)
    match /vet_verifications/{vetId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || (isAuthenticated() && request.auth.uid == vetId);
    }
  }
}

