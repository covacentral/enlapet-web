rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Funciones de ayuda
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        ('email' in request.auth.token) && 
        (request.auth.token.email == 'covacentral@gmail.com' || request.auth.token.email.matches('.*admin.*'));
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. Colección de Usuarios
    match /users/{userId} {
      // Permitir leer si es admin, dueño, o si es una clínica para poder vincular personal por email
      allow read: if isAdmin() || isOwner(userId) || (isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'clinic');
      allow write: if isAdmin() || isOwner(userId);
    }

    // 2. Colección de Mascotas (Pets)
    match /pets/{petId} {
      allow read, update, delete: if isAdmin() || (isAuthenticated() && resource.data.ownerId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow get: if true; 

      // Subcolección de historial clínico
      match /medical_records/{recordId} {
        allow read, write: if isAdmin() || (isAuthenticated() && get(/databases/$(database)/documents/pets/$(petId)).data.ownerId == request.auth.uid);
        allow get: if true;
      }
    }

    // 3. Mapeo de NFC (secureToken -> petId)
    match /nfc_mappings/{secureToken} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.ownerId == request.auth.uid);
    }

    // 4. Colección de Clínicas (Clinics)
    match /clinics/{clinicId} {
      allow read: if true;
      allow write: if isAdmin() || (isAuthenticated() && request.auth.uid == clinicId);

      // Subcolección de Inventario: Solo el admin o el contador pueden ver/editar
      match /inventory/{itemId} {
        allow read, write: if isAuthenticated() && (
          request.auth.uid == clinicId || 
          (exists(/databases/$(database)/documents/clinics/$(clinicId)/staff/$(request.auth.uid)) && 
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.subRole == 'contabilidad')
        );
      }

      // Subcolección de Facturas: Solo el admin o el contador pueden ver/editar
      match /invoices/{invoiceId} {
        allow read, write: if isAuthenticated() && (
          request.auth.uid == clinicId || 
          (exists(/databases/$(database)/documents/clinics/$(clinicId)/staff/$(request.auth.uid)) && 
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.subRole == 'contabilidad')
        );
      }

      // Subcolección de Citas: Solo admin, el dueño de la mascota, o staff con rol recepcion/veterinario
      match /appointments/{appointmentId} {
        allow create: if isAuthenticated();
        allow read, update, delete: if isAuthenticated() && (
          request.auth.uid == clinicId || 
          resource.data.ownerId == request.auth.uid || 
          (exists(/databases/$(database)/documents/clinics/$(clinicId)/staff/$(request.auth.uid)) && 
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.subRole in ['recepcion', 'veterinario'])
        );
      }

      // Subcolección de Logs de Auditoría
      match /audit_logs/{logId} {
        allow create: if isAuthenticated() && (
          request.auth.uid == clinicId || 
          (exists(/databases/$(database)/documents/clinics/$(clinicId)/staff/$(request.auth.uid)) && 
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.subRole == 'veterinario')
        );
        allow read: if isAuthenticated() && request.auth.uid == clinicId;
      }

      // Subcolección de Staff: solo admin o el staff mismo pueden leer
      match /staff/{staffId} {
        allow read: if isAdmin() || (isAuthenticated() && (request.auth.uid == clinicId || request.auth.uid == staffId));
        allow write: if isAdmin() || (isAuthenticated() && request.auth.uid == clinicId);
      }
    }

    // 5. Colección de Permisos Clínicos
    match /clinical_permissions/{permissionId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.vetId || request.auth.uid == resource.data.ownerId);
      allow create: if isAuthenticated() && request.resource.data.vetId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (request.auth.uid == resource.data.ownerId || request.auth.uid == resource.data.vetId);
    }

    // 6. Colección de Verificaciones de Veterinarios (Staff)
    match /vet_verifications/{vetId} {
      allow read: if isAdmin() || (isAuthenticated() && request.auth.uid == vetId);
      allow write: if isAdmin() || (isAuthenticated() && request.auth.uid == vetId);
    }

    // 7. Colección de Invitaciones
    match /invitations/{email} {
      allow read: if isAuthenticated() && request.auth.token.email.lower() == email;
      allow write: if isAdmin() || (isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'clinic');
    }
  }
}
